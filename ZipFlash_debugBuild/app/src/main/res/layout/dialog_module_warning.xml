<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:padding="12dp"
	android:minWidth="280dp"
	android:gravity="center"
	android:background="@drawable/popup_bg">

	<TextView
		android:id="@+id/message_title"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:textColor="#FFFFFF"
		android:text="Caution!"
		android:textSize="26sp"
		android:layout_gravity="center"
		android:textStyle="bold"
		android:contentDescription="Warning title"
		android:paddingTop="2dp"/>

	<TextView
		android:id="@+id/message"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:textColor="#FFFFFF"
		android:textSize="16sp"
		android:text="Flashing too many modules may cause conflicts or override settings, leading to instability. Disable unused modules before flashing new ones."
		android:padding="8dp"
		android:contentDescription="Warning message"
		android:gravity="center"/>

	<Button
		android:id="@+id/btnOk"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:minHeight="48dp"
		android:text="OK"
		android:background="@drawable/btn_normal"
		android:textColor="#FFFFFF"
		android:padding="12dp"
		android:contentDescription="Confirm button"
		android:layout_marginTop="10dp"/>

</LinearLayout>

