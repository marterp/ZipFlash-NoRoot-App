<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#111111">

    <!-- Toolbar for Back Button and Menu -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#111111"
        android:titleTextColor="#CCCCCC" />

    <!-- Command input and Run button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/etCommand"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:hint="Enter command"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:background="@drawable/edit_bg"
            android:padding="8dp"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/btnRun"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Run"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_run"
            android:fontFamily="monospace"
            android:stateListAnimator="@null"
            android:contentDescription="Run command" />
    </LinearLayout>

    <!-- Recent commands (horizontal scrollable list) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="horizontal"
        android:fadeScrollbars="true"
        android:scrollbarFadeDuration="250"
        android:scrollbarDefaultDelayBeforeFade="1000">

        <LinearLayout
            android:id="@+id/recent_commands_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp" />
    </HorizontalScrollView>

    <!-- Divider for readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#888888" />

    <!-- Output text -->
    <TextView
        android:id="@+id/tvOutput"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:padding="8dp"
        android:textSize="12sp"
        android:background="#111111"
        android:textColor="#FFFFFF"
        android:fontFamily="monospace"
        android:textIsSelectable="true"
        android:enabled="true"
        android:focusable="true"
        android:focusableInTouchMode="true" />
</LinearLayout>
