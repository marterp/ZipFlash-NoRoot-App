<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container_dark</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/m3_secondary_dark</item>
        <item name="colorOnSecondary">@color/text_on_accent</item>
        <item name="colorSecondaryContainer">@color/m3_secondary_container_dark</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>

        <!-- Tertiary -->
        <item name="colorTertiary">@color/m3_tertiary_dark</item>
        <item name="colorOnTertiary">@color/text_on_accent</item>
        <item name="colorTertiaryContainer">@color/m3_tertiary_container_dark</item>
        <item name="colorOnTertiaryContainer">@color/text_primary</item>

        <!-- Surface / Background -->
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/bg_card</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <!-- Error -->
        <item name="colorError">@color/accent_error</item>
        <item name="colorOnError">@color/text_primary</item>
        <item name="colorErrorContainer">@color/m3_error_container_dark</item>
        <item name="colorOnErrorContainer">@color/accent_error</item>

        <!-- Outline -->
        <item name="colorOutline">@color/border_default</item>
        <item name="colorOutlineVariant">@color/border_hover</item>

        <!-- Surface containers (M3) -->
        <item name="colorSurfaceContainerLowest">@color/bg_primary</item>
        <item name="colorSurfaceContainerLow">@color/bg_card</item>
        <item name="colorSurfaceContainer">@color/bg_elevated</item>

        <!-- PopupMenu and SearchView styles -->
        <item name="popupMenuStyle">@style/DarkPopupMenu</item>
        <item name="searchViewStyle">@style/SearchViewDark</item>

        <!-- Misc -->
        <item name="actionMenuTextColor">@color/text_primary</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlHighlight">@color/bg_card_hover</item>

        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/bg_primary</item>

        <!-- Font -->
        <item name="android:fontFamily">monospace</item>
    </style>

</resources>
