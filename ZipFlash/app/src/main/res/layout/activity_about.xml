<?xml version="1.0" encoding="utf-8"?>
<ScrollView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:fillViewport="true"
	android:scrollbars="none"
	android:background="#111111">

	<LinearLayout
		android:orientation="vertical"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:fontFamily="monospace"
		android:paddingBottom="20dp">

		<androidx.appcompat.widget.Toolbar
			android:id="@+id/toolbar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize"
			android:background="#111111"
			android:title="About"
			android:titleTextColor="#CCCCCC"
			android:fontFamily="monospace"
			android:elevation="4dp"/>
		
		<ImageView
			android:id="@+id/imgAppIcon"
			android:layout_width="72dp"
			android:layout_height="72dp"
			android:src="@mipmap/ic_launcher"
			android:layout_marginTop="24dp"
			android:layout_marginBottom="8dp"
			android:contentDescription="App Icon"
			android:layout_gravity="center" />

		<TextView
			android:id="@+id/tvAppName"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="ZipFlash"
			android:textColor="#FFFFFF"
			android:textSize="32sp"
			android:textStyle="bold"
			android:paddingTop="16dp"
			android:paddingBottom="8dp"
			android:fontFamily="monospace"
			android:layout_gravity="center"/>

		<TextView
			android:id="@+id/tvNoRoot"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="No Root"
			android:textColor="#FFFFFF"
			android:textSize="18sp"
			android:textStyle="bold"
			android:paddingTop="4dp"
			android:paddingBottom="8dp"
			android:fontFamily="monospace"
			android:layout_gravity="center"/>

		<TextView
			android:id="@+id/tvVersion"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/app_version"
			android:textColor="#AAAAAA"
			android:textSize="16sp"
			android:fontFamily="monospace"
			android:paddingBottom="4dp"
			android:layout_gravity="center"/>

		<TextView
			android:id="@+id/tvDeveloper"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Developer: @mister_p"
			android:textColor="#AAAAAA"
			android:textSize="16sp"
			android:paddingBottom="16dp"
			android:fontFamily="monospace"
			android:layout_gravity="center"/>

		<TextView
			android:id="@+id/tvDescription"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/app_description"
			android:textColor="#CCCCCC"
			android:textColorLink="#00BFFF"
			android:textSize="14sp"
			android:paddingBottom="16dp"
			android:fontFamily="monospace"
			android:lineSpacingExtra="2dp"
			android:autoLink="email"
			android:linksClickable="true"
			android:inputType="textMultiLine"
			android:scrollHorizontally="false"
			android:ellipsize="none"
			android:breakStrategy="simple"
			android:layout_marginLeft="8dp"
			android:layout_marginRight="8dp"/>
		
		
        
     <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingBottom="0dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">
        
        
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/github_icon"
            android:contentDescription="GitHub"
            android:layout_gravity="center"
            android:padding="4dp"/>
        
		<Button
            android:id="@+id/btnGithub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GitHub"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_normal"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>
        
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/youtube_icon"
            android:contentDescription="YouTube"
            android:layout_gravity="center"
            android:padding="4dp"/>

		<Button
			android:id="@+id/btnYouTube"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="YouTube"
			android:textColor="#FFFFFF"
			android:background="@drawable/btn_normal"
			android:fontFamily="monospace"
			android:layout_marginBottom="8dp"/>

		<Button
			android:id="@+id/btnTikTok"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="TikTok"
			android:textColor="#FFFFFF"
			android:background="@drawable/btn_normal"
			android:fontFamily="monospace"
			android:visibility="gone"
			android:layout_marginBottom="8dp"/>

		<Button
			android:id="@+id/btnFacebook"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Facebook"
			android:textColor="#FFFFFF"
			android:background="@drawable/btn_normal"
			android:fontFamily="monospace"
			android:visibility="gone"
			android:layout_marginBottom="8dp"/>
		
		 <Button
			 android:id="@+id/btnZipflashWebsite"
			 android:layout_width="match_parent"
			 android:layout_height="wrap_content"
			 android:text="Visit ZipFlash Website"
			 android:textColor="#FFFFFF"
			 android:fontFamily="monospace"
			 android:background="@drawable/btn_normal"
			 android:layout_marginBottom="8dp"/>

		<Button
			android:id="@+id/btnDonate"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Support Me"
			android:textColor="#FFFFFF"
			android:background="@drawable/btn_normal"
			android:fontFamily="monospace"
			android:visibility="visible"
			android:layout_marginBottom="8dp"/>
		
		 <View
			 android:layout_width="match_parent"
			 android:layout_height="1dp"
			 android:background="#333333"
			 android:layout_marginHorizontal="8dp"/>
         
		<Button
			android:id="@+id/btnTermsCond"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Terms And Privacy"
			android:textColor="#FFFFFF"
			android:background="@drawable/btn_normal"
			android:fontFamily="monospace"
			android:layout_marginBottom="8dp"/>
		
		 <Button
			 android:id="@+id/btnContributors"
			 android:layout_width="match_parent"
			 android:layout_height="wrap_content"
			 android:text="Contributors"
			 android:visibility="gone"
			 android:textColor="#FFFFFF"
			 android:background="@drawable/btn_normal"
			 android:fontFamily="monospace"
			 android:layout_marginBottom="8dp"/>
		 
        </LinearLayout>
	</LinearLayout>

</ScrollView>

