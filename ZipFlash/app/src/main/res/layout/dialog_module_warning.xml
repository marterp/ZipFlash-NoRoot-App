<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_md"
    android:minWidth="280dp"
    android:gravity="center"
    android:background="@drawable/popup_bg">

    <TextView
        android:id="@+id/message_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/accent_warning"
        android:text="Caution!"
        android:textSize="26sp"
        android:layout_gravity="center"
        android:textStyle="bold"
        android:contentDescription="Warning title"
        android:paddingTop="@dimen/spacing_xxs"/>

    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:text="Flashing too many modules may cause conflicts or override settings, leading to instability. Disable unused modules before flashing new ones."
        android:padding="@dimen/spacing_sm"
        android:contentDescription="Warning message"
        android:gravity="center"
        android:lineSpacingExtra="2dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OK"
        style="@style/M3Button"
        android:contentDescription="Confirm button"
        android:layout_marginTop="@dimen/spacing_sm"/>

</LinearLayout>
