<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="0dp"
    android:layout_margin="@dimen/spacing_md"
    android:gravity="center_horizontal"
    android:minWidth="310dp"
    android:maxWidth="360dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Update Available!"
        android:background="@drawable/dialog_title_bg"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:padding="@dimen/spacing_sm"/>

    <!-- Scrollable Changelog -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxHeight="200dp"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical"
        android:layout_marginTop="@dimen/spacing_sm"
        android:fadeScrollbars="true"
        android:scrollbarFadeDuration="250"
        android:scrollbarDefaultDelayBeforeFade="1000"
        android:layout_marginBottom="@dimen/spacing_sm">

        <TextView
            android:id="@+id/tvChangelog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:padding="@dimen/spacing_sm"
            android:lineSpacingExtra="2dp"/>
    </ScrollView>

    <!-- Update Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUpdateNow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Update!"
        style="@style/M3Button"
        android:layout_margin="@dimen/spacing_sm"
        android:layout_gravity="end"
        android:minWidth="120dp"/>
</LinearLayout>
