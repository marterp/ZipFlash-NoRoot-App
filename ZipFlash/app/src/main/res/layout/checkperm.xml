<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_primary"
        android:title="Permission"/>

    <!-- Top spacer -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Centered content -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Checking Shizuku..."
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="@dimen/spacing_lg"
            android:textColor="@color/text_primary"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Grant"
            style="@style/M3Button"
            android:minWidth="160dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShizukuAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open Shizuku"
            android:visibility="gone"
            style="@style/M3Button.Tonal"
            android:layout_marginTop="@dimen/spacing_md"/>
    </LinearLayout>

    <!-- Bottom spacer -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
