<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_xxs"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="@dimen/elevation_none"
    app:cardBackgroundColor="@color/bg_card"
    app:strokeColor="@color/border_default"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_md"
        android:gravity="center_vertical">

        <!-- Module Name -->
        <TextView
            android:id="@+id/moduleName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Module Name"
            android:textSize="14sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:paddingEnd="@dimen/spacing_sm"/>

        <!-- Enable/Disable Switch -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/moduleSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="@dimen/spacing_sm" />

        <!-- Delete Button -->
        <ImageButton
            android:id="@+id/moduleDelete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_del_module"
            app:tint="@color/accent_error" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
